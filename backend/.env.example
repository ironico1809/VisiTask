# Configuración del Entorno - ErgoCheck AI Backend
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database URL
DATABASE_URL="postgresql://usuario:clave@host:5432/nombre_bd"
DIRECT_URL="postgresql://usuario:clave@host:5432/nombre_bd"

# JWT Configuración de Seguridad
JWT_SECRET="tu-clave-secreta-jwt-aqui"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="tu-clave-refresh-jwt-aqui"
JWT_REFRESH_EXPIRES_IN="30d"

# Supabase Project Ref (Opcional)
SUPABASE_PROJECT_ID="tu_ref_proyecto"
